# Local development only; see docs/development.md.
# Docker without login needs no env file.
# Host Next.js: copy only the HOST WEB section to .env.local.
# Docker + Entra: copy this template to .env.dev-auth and fill ENTRA values;
# Compose supplies its own container database and identity settings.
# Supply worker credentials through a local secret launcher, never this file.

# --- HOST WEB ---
AUTH_MODE=development
DEV_USER_EMAIL=developer@localhost
DEV_USER_NAME="Local developer"
DATABASE_URL=postgresql://dispatch_route_review:dispatch_route_review@localhost:5432/dispatch_route_review
DATABASE_POOL_SIZE=10
DATABASE_SSL=disable
# Public routing is a local-development fallback only.
OSRM_BASE_URL=https://router.project-osrm.org
# App-only optional Autotask web UI origin (e.g. https://wwN.autotask.net).
# Empty disables ticket links, including in the demo.
AUTOTASK_WEB_URL=

# Non-secret placeholders; replace with your tenant IDs for real cached data.
AUTOTASK_READY_TO_BOOK_QUEUE_ID=101
AUTOTASK_READY_TO_BOOK_STATUS_ID=401

# --- WORKER SCOPE (not needed by host Next.js) ---
# Optional exact company field name; empty groups third-party visits by status.
AUTOTASK_THIRD_PARTY_COMPANY_FIELD=
# Your tenant's REST zone; replace N with its zone number.
AUTOTASK_BASE_URL=https://webservicesN.autotask.net/ATServicesRest/V1.0
# Replace the contact placeholder before sending requests to a public geocoder.
GEOCODER_USER_AGENT_CONTACT=https://example.com/dispatch-route-review
AUTOTASK_SUPPORT_QUEUE_IDS=101,102
AUTOTASK_INSTALL_QUEUE_IDS=201
AUTOTASK_SURVEY_QUEUE_IDS=301
AUTOTASK_REQUESTED_STATUS_IDS=401,402
AUTOTASK_ACCESS_STATUS_IDS=501,502
AUTOTASK_THIRD_PARTY_REQUEST_STATUS_IDS=601,602

# --- OPTIONAL ENTRA (Docker overlay only; keep real secrets out of .env.local) ---
# Separate development Web registration; callback https://localhost:3443/oauth2/callback.
# Replace the tenant example with the concrete, non-zero tenant GUID; never use
# common, organizations, or another multi-tenant alias. Never reuse prod secrets.
ENTRA_TENANT_ID=11111111-2222-3333-4444-555555555555
OAUTH2_PROXY_CLIENT_ID=00000000-0000-0000-0000-000000000000
OAUTH2_PROXY_CLIENT_SECRET=REPLACE_WITH_DEVELOPMENT_ENTRA_CLIENT_SECRET
# Generate independently: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OAUTH2_PROXY_COOKIE_SECRET=REPLACE_WITH_32_BYTE_BASE64URL_SECRET
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
# Change only if this subnet overlaps an existing network.
DEV_AUTH_EDGE_SUBNET=172.31.77.0/24
