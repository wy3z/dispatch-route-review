# Deployment template; see docs/deployment.md.
# Copy to protected .env.prod on the deployment host; it is ignored by Docker and Git.
# Always use `docker compose --env-file .env.prod ...`; Compose does not load
# this filename automatically.
#
# Generate this password with `openssl rand -hex 32`. Hex is deliberate: the
# Compose file embeds it in a PostgreSQL URL.
POSTGRES_DB=dispatch_route_review
POSTGRES_USER=dispatch_route_review
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DATABASE_POOL_SIZE=10

# Administrators are provisioned explicitly by immutable external subject after
# the intended account has authenticated once; see docs/deployment.md.
OSRM_BASE_URL=https://routing.internal.example
# App-only optional Autotask web UI origin (e.g. https://wwN.autotask.net).
# Empty disables ticket links, including in the demo.
AUTOTASK_WEB_URL=

# Complete docs/geocoding-runbook.md before populating these values. Production
# refuses public fallbacks, non-HTTPS URLs, redirects, and hosts absent from the
# comma-separated exact host[:port] allowlist.
UK_GEOCODER_URL=https://approved-geocoder.example/postcodes
EU_GEOCODER_URL=https://approved-geocoder.example/search
GEOCODER_ALLOWED_HOSTS=approved-geocoder.example
# Worker-only identifying contact; replace with a URL maintained by your deployment.
GEOCODER_USER_AGENT_CONTACT=https://example.com/dispatch-route-review

# APP_FQDN must resolve through the deployment edge.
# ACME_EMAIL and EDGE_SUBNET configure Traefik in docker/compose.example.yml.
APP_FQDN=routes.example.com
ACME_EMAIL=ops@example.com
EDGE_SUBNET=172.30.0.0/24

# Microsoft Entra web application. Register exactly this redirect URI:
# https://${APP_FQDN}/oauth2/callback
# Use the concrete non-zero tenant GUID; multi-tenant aliases are rejected.
ENTRA_TENANT_ID=11111111-2222-3333-4444-555555555555
OAUTH2_PROXY_CLIENT_ID=00000000-0000-0000-0000-000000000000
OAUTH2_PROXY_CLIENT_SECRET=REPLACE_WITH_ENTRA_CLIENT_SECRET_VALUE
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OAUTH2_PROXY_COOKIE_SECRET=REPLACE_WITH_32_BYTE_BASE64URL_SECRET
# Entra tenant restriction is primary; optionally also restrict by email domain.
OAUTH2_PROXY_EMAIL_DOMAINS=example.com

# Non-secret example IDs only: replace every value with your tenant IDs.
# Ready-to-book IDs go to app and worker; all other IDs go only to worker.
AUTOTASK_SUPPORT_QUEUE_IDS=101,102
AUTOTASK_INSTALL_QUEUE_IDS=201
AUTOTASK_SURVEY_QUEUE_IDS=301
AUTOTASK_REQUESTED_STATUS_IDS=401,402
AUTOTASK_ACCESS_STATUS_IDS=501,502
AUTOTASK_THIRD_PARTY_REQUEST_STATUS_IDS=601,602
AUTOTASK_READY_TO_BOOK_QUEUE_ID=101
AUTOTASK_READY_TO_BOOK_STATUS_ID=401

# Injected only into the cache-worker container.
# Optional exact company field name; empty groups third-party visits by status.
AUTOTASK_THIRD_PARTY_COMPANY_FIELD=
AUTOTASK_API_CODE=REPLACE_WITH_READ_ONLY_INTEGRATION_CODE
AUTOTASK_USERNAME=REPLACE_WITH_READ_ONLY_API_USERNAME
AUTOTASK_SECRET=REPLACE_WITH_READ_ONLY_API_SECRET
# Your tenant's REST zone; replace N with its zone number.
AUTOTASK_BASE_URL=https://webservicesN.autotask.net/ATServicesRest/V1.0

CACHE_WARM_PAST_DAYS=30
CACHE_WARM_FUTURE_DAYS=30
CACHE_WORKER_POLL_SECONDS=10
CACHE_WORKER_BATCH_SIZE=2
CACHE_REFRESH_LEASE_SECONDS=1800
